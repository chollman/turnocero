#!/bin/sh
# Enforce English-only commit messages (no non-ASCII characters)

commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

# Skip merge commits
case "$first_line" in
  Merge*) exit 0 ;;
esac

if printf '%s' "$first_line" | grep -qP '[^\x00-\x7F]'; then
  echo ""
  echo "  Commit message must be written in English."
  echo "  Non-ASCII characters are not allowed in the subject line."
  echo ""
  echo "  Subject: $first_line"
  echo ""
  exit 1
fi
