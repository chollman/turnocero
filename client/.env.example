# URL del backend (Socket.IO + fallback). En dev, Vite proxea /api a :4000.
VITE_API_URL=http://localhost:4000

# ── OAuth login (Google / Facebook) ──────────────────────────────────
# Client ID de Google Identity Services (mismo valor que GOOGLE_CLIENT_ID
# del server). Sin esto, el botón de Google no funciona.
VITE_GOOGLE_CLIENT_ID=
# App ID de la app de Facebook (mismo de FB_APP_ID en el server). Sin esto,
# el botón de Facebook no se muestra.
VITE_FB_APP_ID=
