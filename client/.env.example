# URL del backend (Socket.IO + fallback). En dev, Vite proxea /api a :4000.
VITE_API_URL=http://localhost:4000

# Subdominios por comunidad (single-tenant): dominio apex del sitio. Cuando la
# app se sirve en `<slug>.<VITE_TENANT_DOMAIN>` (ej. patagonia.turnocero.com),
# todo se acota a esa comunidad. Vacío = sin subdominios (sitio multi-comunidad).
# En dev podés probar sin DNS con `?tenant=<slug>` o `<slug>.localhost:3000`.
# VITE_TENANT_DOMAIN=turnocero.app

# ── OAuth login (Google / Facebook) ──────────────────────────────────
# Client ID de Google Identity Services (mismo valor que GOOGLE_CLIENT_ID
# del server). Sin esto, el botón de Google no funciona.
VITE_GOOGLE_CLIENT_ID=
# App ID de la app de Facebook (mismo de FB_APP_ID en el server). Sin esto,
# el botón de Facebook no se muestra.
VITE_FB_APP_ID=
