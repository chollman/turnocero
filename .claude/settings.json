{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Preview__preview_eval",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/preview-login.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' >> /tmp/turnocero-prettier-queue.txt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/claudiohollman/Projects/turnocero/scripts/prettier-modified.sh"
          }
        ]
      }
    ]
  }
}
