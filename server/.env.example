MONGODB_URI=mongodb://localhost:27017/turnocero
JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=4000
# Comma-separated list of allowed frontend origins (defaults to http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Optional: override DNS servers (useful on Windows if system DNS blocks SRV lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Cloudinary — required for image uploads (Fase 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# BoardGameGeek API Key (registrar en boardgamegeek.com/applications)
BGG_API_KEY=

# AES-256-GCM master key for encrypting BGG passwords at rest.
# 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates all stored BGG passwords (users must reconnect).
BGG_CREDS_KEY=

# Resend — para verificación de email y recuperar contraseña.
# Crear cuenta en https://resend.com y generar una API key.
RESEND_API_KEY=
# Remitente verificado en Resend (ej: "TurnoCero <hola@turnocero.com>").
# En dev podés usar "onboarding@resend.dev" sin verificar dominio.
EMAIL_FROM=onboarding@resend.dev

# URL pública del frontend, usada para construir links en emails
# (verificación, recuperar contraseña). Sin trailing slash.
FRONTEND_URL=http://localhost:3000

# ── OAuth login (Google / Facebook) ──────────────────────────────────
# Google: crear un "OAuth 2.0 Client ID" (tipo Web) en
# console.cloud.google.com → APIs & Services → Credentials. Agregar
# http://localhost:3000 (dev) + el dominio prod a "Authorized JavaScript
# origins". El server usa este id para verificar el audience del ID token.
# Debe coincidir con VITE_GOOGLE_CLIENT_ID del cliente.
GOOGLE_CLIENT_ID=
# Facebook: crear una app en developers.facebook.com con el producto
# "Facebook Login". El server valida el access token contra Graph API.
# Para producción hace falta App Review del permiso "email".
FB_APP_ID=
FB_APP_SECRET=

# Google Maps — server-side key para Geocoding API.
# Crear en console.cloud.google.com → APIs & Services → Credentials.
# Restringir a IP del backend + solo Geocoding API.
GOOGLE_MAPS_API_KEY=

# YouTube Data API v3 — server-side key para la sección "Andá preparado"
# del TableDetail (busca tutoriales "Como se juega <juego>" en YouTube).
# Crear en console.cloud.google.com → APIs & Services → Credentials.
# Habilitar "YouTube Data API v3" y restringir la key por IP del backend.
# Free tier: 10 000 units/día (1 búsqueda = ~101 units → ~99 búsquedas/día).
# El cache Mongo de 7 días absorbe la mayoría — solo se queman units en
# juegos nunca vistos. Si está vacía, la sección no se renderiza.
YOUTUBE_API_KEY=
