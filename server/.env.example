MONGODB_URI=mongodb://localhost:27017/turnocero
JWT_SECRET=your_super_secret_jwt_key_change_this
PORT=4000
# Comma-separated list of allowed frontend origins (defaults to http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Optional: override DNS servers (useful on Windows if system DNS blocks SRV lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Cloudinary — required for image uploads (Fase 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# BoardGameGeek API Key (registrar en boardgamegeek.com/applications)
BGG_API_KEY=

# AES-256-GCM master key for encrypting BGG passwords at rest.
# 64-char hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates all stored BGG passwords (users must reconnect).
BGG_CREDS_KEY=

# Resend — para verificación de email y recuperar contraseña.
# Crear cuenta en https://resend.com y generar una API key.
RESEND_API_KEY=
# Remitente verificado en Resend (ej: "TurnoCero <hola@turnocero.com>").
# En dev podés usar "onboarding@resend.dev" sin verificar dominio.
EMAIL_FROM=onboarding@resend.dev

# URL pública del frontend, usada para construir links en emails
# (verificación, recuperar contraseña). Sin trailing slash.
FRONTEND_URL=http://localhost:3000
